{
  "name": "dgb",
  "version": "0.1.0",
  "description": "CLI for Diego G Brisa packages.",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "bin": {
    "dgb": "./dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "diegogbrisa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiegoGBrisa/dgb.git"
  },
  "bugs": {
    "url": "https://github.com/DiegoGBrisa/dgb/issues"
  },
  "homepage": "https://github.com/DiegoGBrisa/dgb#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "typescript": "^5.9.3"
  }
}
